# Basic
APP_ENV=development
APP_BASE_URL=https://orbit.elstella.com
API_BASE_URL=http://localhost:8080/api/v1
PORT=8080
LOG_LEVEL=info
TZ=Asia/Shanghai

# Database
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-64-byte-base64-secret-here-change-in-production
REFRESH_TOKEN_TTL=168h
ACCESS_TOKEN_TTL=15m
ENCRYPTION_MASTER_KEY=your-32-byte-base64-master-key-here
BCRYPT_COST=12

# OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=
BING_CLIENT_ID=
BING_CLIENT_SECRET=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
