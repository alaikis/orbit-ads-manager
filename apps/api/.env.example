# apps/api/.env.example — 复制到 .env 并填入实际值
# ENCRYPTION_MASTER_KEY (32 字节精确) — token/credential 加密用
ENCRYPTION_MASTER_KEY=replace_with_32_byte_random_string_here

# JWT — 登录态
JWT_SECRET=replace_with_random_jwt_secret

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orbit
DB_USER=orbit
DB_PASSWORD=orbit

# Server
SERVER_PORT=8080
GIN_MODE=release

# CORS — 允许的前端来源
CORS_ALLOWED_ORIGINS=https://ads.alaikis.com

# OAuth 平台客户端配置（占位 - 6 平台）
# 加载优先级：DB platform_providers 表 → 本环境变量 → 401
#
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: https://adsapi.alaikis.com/api/v1/connections/oauth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=  # 可选，默认从请求 scheme+host 推断

# Microsoft (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
# Bing 共享 Microsoft OAuth app（同一 client_id/secret）
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_BING_CLIENT_ID=
OAUTH_BING_CLIENT_SECRET=

# Meta / Facebook (https://developers.facebook.com/apps/)
OAUTH_META_CLIENT_ID=
OAUTH_META_CLIENT_SECRET=

# TikTok Marketing API (https://ads.tiktok.com/marketing_api/homepage)
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=

# Shopify (https://shopify.dev/apps)
OAUTH_SHOPIFY_CLIENT_ID=
OAUTH_SHOPIFY_CLIENT_SECRET=

# API Key 类平台 (非 OAuth) — 由租户在 UI 提交，不在此管理
# - woocommerce: Basic Auth (consumer_key/consumer_secret)
# - shopify (api_key flow): Admin API access_token
# - llm: provider / api_key / base_url
# - smtp: host/port/username/password
